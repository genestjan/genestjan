# RideWise configuration. Copy to .env.local and fill in what you have.
# Every variable is optional: without them RideWise uses the free public
# OpenStreetMap services listed below, which have fair-use limits and no SLA.
# Anything prefixed VITE_ is bundled into the browser and is PUBLIC.
# Never put a private API key in a VITE_ variable.

# --- Routing --------------------------------------------------------------
# Default: FOSSGIS public OSRM bicycle server (no key, fair use, no SLA).
VITE_OSRM_BIKE_URL=https://routing.openstreetmap.de/routed-bike
# Optional: URL of the Supabase Edge Function that proxies openrouteservice
# (supabase/functions/route-proxy). The ORS key stays on the server.
VITE_ROUTE_PROXY_URL=

# --- Place search (OpenStreetMap Overpass API) ----------------------------
# Comma-separated list, tried in order with backoff when one is busy.
VITE_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter

# --- Geocoding (Nominatim, max 1 request/second, no autocomplete) ---------
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Weather (Open-Meteo, free for non-commercial use) --------------------
VITE_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# --- Map tiles ------------------------------------------------------------
# tile.openstreetmap.org is fine for light use. For heavier traffic, use a
# commercial tile provider and put its public, domain-restricted key here.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# --- Account sync (optional, Supabase) ------------------------------------
# The anon key is designed to be public; Row Level Security protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side only (Supabase Edge Function secrets, NOT for .env.local) -
# Set with: supabase secrets set ORS_API_KEY=...
# ORS_API_KEY=
# ALLOWED_ORIGIN=https://genestjanramirez.com
