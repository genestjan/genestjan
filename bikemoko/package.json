{
  "name": "bikemoko",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bikemoko Unified Inventory, POS and Service Repair",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:app": "tsc -b && vite build --mode app",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview",
    "electron:build": "npm run build:app && electron-builder --win --publish never"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^7.5.0",
    "@capacitor/android": "^7.6.11",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.6.11",
    "@capacitor/haptics": "^7.0.5",
    "@supabase/supabase-js": "^2.119.2",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.454.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.11",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.7.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.34",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "author": "Bikemoko",
  "build": {
    "appId": "com.bikemoko.desktop",
    "productName": "Bikemoko",
    "artifactName": "Bikemoko-Setup.exe",
    "directories": {
      "output": "electron-dist",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.ico",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
