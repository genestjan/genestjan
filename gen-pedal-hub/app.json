{
  "expo": {
    "name": "GenRide",
    "slug": "gen-pedal-hub",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "genpedalhub",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.genestjan.genpedalhub",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#050A18",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050A18",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GenRide uses your location to record your ride.",
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#050A18"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GenRide lets you add a photo to a post you share."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true,
      "baseUrl": "/pedalhub"
    }
  }
}